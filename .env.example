# InsightForge — Environment Variables
# Copy this file to .env and fill in your production values.
# In development, none of these are required (the app uses safe defaults).
#
# IMPORTANT: Never commit a filled .env file to version control.

# ────────────────────────────────────────────────────────────
# Django Core
# ────────────────────────────────────────────────────────────
# Generate a strong key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here

# Set to "False" in production
DJANGO_DEBUG=False

# Comma-separated list of allowed host names (no spaces)
# Example: DJANGO_ALLOWED_HOSTS=insightforge.example.com,www.insightforge.example.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ────────────────────────────────────────────────────────────
# MongoDB (optional — Django SQLite auth is used as fallback)
# ────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=insightforge_auth

# ────────────────────────────────────────────────────────────
# Dataset upload limit (default: 50 MB)
# ────────────────────────────────────────────────────────────
DATASET_MAX_UPLOAD_MB=50
